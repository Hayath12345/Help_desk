// Loons Help Desk — Prisma schema
//
// Conventions
// - Config records are never hard-deleted: archive with `isActive = false`. Tickets keep
//   referencing archived rows and still render them.
// - Every config record has a stable `key` separate from its EN/AR labels.
// - Ticket numbers are human IDs rendered as `LG-<number>` (sequence-backed, see migration).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  CLIENT
  AGENT
  TEAM_LEAD
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING_APPROVAL // self-signup whose email domain matched no organisation
  DISABLED
}

enum Locale {
  en
  ar
}

enum AuthProvider {
  GOOGLE
  MICROSOFT_ENTRA_ID
}

enum ContractType {
  AMC
  BILLABLE
}

enum TeamMemberRole {
  MEMBER
  LEAD
}

enum TicketType {
  INCIDENT
  SERVICE_REQUEST
  CHANGE_REQUEST
  SECURITY_INCIDENT
  ENQUIRY
}

enum Priority {
  P1
  P2
  P3
  P4
}

enum Impact {
  SINGLE_USER
  DEPARTMENT
  ENTIRE_SITE
  MULTIPLE_SITES
}

enum TicketStatus {
  NEW
  OPEN
  PENDING
  SOLVED
  CLOSED
}

enum TicketChannel {
  PORTAL
  EMAIL
  PHONE
  API
}

enum MessageType {
  PUBLIC
  INTERNAL
  SYSTEM
}

enum TicketEventType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNEE_CHANGED
  TEAM_CHANGED
  CATEGORY_CHANGED
  SUBTYPE_CHANGED
  TYPE_CHANGED
  TAGS_CHANGED
  FIRST_REPLY
  REOPENED
  SLA_AT_RISK
  SLA_BREACHED
  P1_ACKNOWLEDGED
  ESCALATED
  AUTO_CLOSED
  // Console edits of the remaining ticket fields (spec §7: every change writes a TicketEvent).
  IMPACT_CHANGED
  SITE_CHANGED
  ASSET_CHANGED
  /// meta: { fields: string[] } — the custom-field keys that changed (values are not copied).
  CUSTOM_FIELDS_CHANGED
}

enum AttachmentStatus {
  PENDING // pre-signed URL issued, upload not confirmed
  UPLOADED // object exists, awaiting scan
  CLEAN
  INFECTED
  REJECTED
}

/// Who an upload is for, fixed at presign (API contract ATTACHMENT_VISIBILITIES): PUBLIC files can
/// only be linked to a PUBLIC message (or a new ticket's description), INTERNAL files only to an
/// INTERNAL note (staff only).
enum AttachmentVisibility {
  PUBLIC
  INTERNAL
}

enum CustomFieldType {
  TEXT
  NUMBER
  DROPDOWN
  MULTI_SELECT
  DATE
  YES_NO
  ASSET_ID
}

enum EscalationTargetType {
  ON_CALL // the team's on-call user
  ROLE // every member of the team holding `targetRole` (e.g. TEAM_LEAD)
  USER // a specific user (e.g. the manager)
}

enum EscalationChannel {
  EMAIL
  TEAMS
  SMS
}

enum NotificationType {
  TICKET_CREATED
  TICKET_ASSIGNED
  CLIENT_REPLY
  AGENT_REPLY
  STATUS_CHANGED
  SLA_AT_RISK
  SLA_BREACHED
  P1_CREATED
  P1_ESCALATED
  P1_ACKNOWLEDGED
}

/// The two SLA targets of a ticket (spec §7).
enum SlaTarget {
  FIRST_REPLY
  RESOLUTION
}

/// An SLA threshold crossed by a target: `atRiskPercent` of its window (AT_RISK) or 100 % (BREACHED).
enum SlaSignalKind {
  AT_RISK
  BREACHED
}

/// Outbound notification channels logged in NotificationDelivery (in-app notifications are the
/// Notification table).
enum NotificationChannel {
  EMAIL
  TEAMS
  SMS
}

enum NotificationDeliveryStatus {
  QUEUED // recorded, not sent yet (or being retried)
  SENT // accepted by the provider (SMTP / SES, the Teams webhook or console, SNS or console)
  FAILED // gave up after the last attempt (the dead-letter record)
  SKIPPED // deliberately not sent (e.g. SMS cap, no phone number, no webhook)
}

/// What an admin write did (decision E17). DELETE is only for join rows (team members, category
/// fields); config rows are archived. APPROVE / REJECT: pending client sign-ups (E10).
enum AuditAction {
  CREATE
  UPDATE
  ARCHIVE
  RESTORE
  REORDER
  DELETE
  APPROVE
  REJECT
}

// ───────────────────────────── Identity ─────────────────────────────

model Organization {
  id               String       @id @default(uuid()) @db.Uuid
  key              String       @unique
  name             String
  nameAr           String?
  contractType     ContractType @default(AMC)
  amcExpiry        DateTime?    @db.Date
  accountManagerId String?      @db.Uuid
  /// Lower-case email domains whose sign-ups auto-join this organisation (e.g. "qnb.com").
  emailDomains     String[]     @default([])
  phone            String?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  accountManager User?    @relation("AccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  sites          Site[]
  users          User[]   @relation("OrgUsers")
  tickets        Ticket[]

  @@index([isActive])
}

model Site {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  key       String
  name      String
  nameAr    String?
  address   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  tickets Ticket[]

  @@unique([orgId, key])
  @@index([orgId])
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  /// Always stored lower-cased.
  email             String     @unique
  name              String
  role              Role
  status            UserStatus @default(ACTIVE)
  /// Set for CLIENT users only.
  orgId             String?    @db.Uuid
  locale            Locale     @default(en)
  phone             String?
  jobTitle          String?
  /// argon2id hash. Null for SSO-only accounts.
  passwordHash      String?
  /// Incremented to revoke every existing session and API token — password reset now; admin
  /// disable / role change later. Web sessions and API tokens carry the value they were issued
  /// with (`sv`) and are rejected once it differs.
  sessionVersion    Int        @default(0)
  /// Set once the user proved they own the mailbox (verification link, password reset, or a
  /// verified Google / Entra identity). Unverified clients can sign in but see nothing.
  emailVerifiedAt   DateTime?
  /// MFA-ready: staff sign in through Entra ID (MFA enforced there). These fields allow a
  /// local TOTP factor to be added later without a schema change.
  mfaEnabled        Boolean    @default(false)
  mfaSecret         String?
  /// Company name typed at self-signup when no organisation matched (for admin review).
  signupCompany     String?
  /// Staff only: takes tickets handed out automatically by skill (see Skill / Category.skills).
  /// Switch off while away; the account stays a team member and can still be assigned by hand.
  acceptsAutoAssign Boolean    @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  org                     Organization?            @relation("OrgUsers", fields: [orgId], references: [id], onDelete: Restrict)
  accounts                AuthAccount[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  teamMemberships         TeamMember[]
  onCallForTeams          Team[]                   @relation("TeamOnCall")
  managedOrgs             Organization[]           @relation("AccountManager")
  requestedTickets        Ticket[]                 @relation("TicketRequester")
  assignedTickets         Ticket[]                 @relation("TicketAssignee")
  p1AckedTickets          Ticket[]                 @relation("TicketP1Ack")
  messages                Message[]
  attachments             Attachment[]
  ticketEvents            TicketEvent[]
  notifications           Notification[]
  notificationDeliveries  NotificationDelivery[]
  macrosCreated           Macro[]
  escalationTargets       EscalationRule[]
  auditLogs               AdminAuditLog[]
  emailTemplateEdits      EmailTemplate[]
  skills                  UserSkill[]

  @@index([orgId])
  @@index([role])
}

/// Linked external identities (Google for clients, Microsoft Entra ID for staff).
model AuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  provider          AuthProvider
  providerAccountId String
  email             String
  createdAt         DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  /// SHA-256 of the token sent by email; the raw token is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Email-address verification links for client self-signup (single use, 24 h). A new link
/// deletes the user's older unused ones.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  /// SHA-256 of the token sent by email; the raw token is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Teams ─────────────────────────────

model Team {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @unique
  nameEn          String
  nameAr          String
  /// Distribution list notified on new tickets routed to this team.
  emails          String[] @default([])
  /// Microsoft Teams incoming-webhook URL (secret; never exposed to clients).
  teamsWebhookUrl String?
  onCallUserId    String?  @db.Uuid
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  onCallUser      User?                  @relation("TeamOnCall", fields: [onCallUserId], references: [id], onDelete: SetNull)
  members         TeamMember[]
  categories      Category[]
  tickets         Ticket[]
  macros          Macro[]
  escalationRules EscalationRule[]
  deliveries      NotificationDelivery[]
}

model TeamMember {
  teamId    String         @db.Uuid
  userId    String         @db.Uuid
  role      TeamMemberRole @default(MEMBER)
  createdAt DateTime       @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

// ───────────────────────────── Tickets ─────────────────────────────

model Ticket {
  id           String        @id @default(uuid()) @db.Uuid
  /// Human ID, displayed as `LG-<number>`. Backed by a Postgres sequence.
  number       Int           @unique @default(autoincrement())
  type         TicketType
  subject      String
  description  String
  categoryId   String        @db.Uuid
  subtypeId    String?       @db.Uuid
  priority     Priority
  impact       Impact        @default(SINGLE_USER)
  status       TicketStatus  @default(NEW)
  channel      TicketChannel @default(PORTAL)
  orgId        String        @db.Uuid
  siteId       String?       @db.Uuid
  /// Free-text asset / device identifier (e.g. CAM-014).
  assetId      String?
  requesterId  String        @db.Uuid
  assigneeId   String?       @db.Uuid
  teamId       String        @db.Uuid
  /// Values for configured custom fields, keyed by CustomField.key.
  customFields Json          @default("{}")

  firstReplyDueAt     DateTime?
  resolveDueAt        DateTime?
  firstRepliedAt      DateTime?
  solvedAt            DateTime?
  closedAt            DateTime?
  slaAtRiskAt         DateTime?
  slaBreached         Boolean   @default(false)
  slaBreachedAt       DateTime?
  /// Set while the ticket is PENDING (resolution clock paused); cleared on resume.
  slaPausedAt         DateTime?
  /// Finished PENDING pauses, oldest first: [{ "from": ISO, "to": ISO }]. A priority change
  /// recomputes resolveDueAt from createdAt and replays them, so waiting on the client stays credited.
  slaPauses           Json      @default("[]")
  /// When `SlaPolicy.atRiskPercent` of the first-reply window has elapsed in SLA time (business
  /// minutes for business-hours policies, wall-clock for 24/7). Stored with the due dates wherever
  /// they are computed (create, priority change); the web, the SQL views and the SLA worker only
  /// compare `now` with it. Null on tickets created before Phase 3 until the SLA scan backfills it
  /// (a null instant is never "at risk").
  firstReplyAtRiskAt  DateTime?
  /// Same for the resolution window; a PENDING pause shifts it like `resolveDueAt` (an instant
  /// that had already passed when the pause started stays where it was).
  resolveAtRiskAt     DateTime?
  p1AckedAt           DateTime?
  p1AckedById         String?   @db.Uuid
  /// When the ticket became P1 (creation, or a later upgrade to P1); null while it is not P1.
  /// Escalation steps fire `EscalationRule.afterMins` after it. Starting or ending a P1 period
  /// also resets `p1EscalationStep` and the acknowledgement.
  p1Since             DateTime?
  /// Last escalation step fired in the current P1 period (0 = none yet).
  p1EscalationStep    Int       @default(0)
  /// When a priority change last moved the due dates / at-risk instants. The SLA scan measures the
  /// freshness of a crossing (D10) from the later of this and the crossing itself, so a crossing
  /// that a priority change puts in the past is still announced. Null: never re-targeted.
  slaTargetsChangedAt DateTime?
  lastMessageAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category      Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subtype       Subtype?               @relation(fields: [subtypeId], references: [id], onDelete: Restrict)
  org           Organization           @relation(fields: [orgId], references: [id], onDelete: Restrict)
  site          Site?                  @relation(fields: [siteId], references: [id], onDelete: Restrict)
  requester     User                   @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee      User?                  @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  team          Team                   @relation(fields: [teamId], references: [id], onDelete: Restrict)
  p1AckedBy     User?                  @relation("TicketP1Ack", fields: [p1AckedById], references: [id], onDelete: SetNull)
  messages      Message[]
  attachments   Attachment[]
  tags          TicketTag[]
  events        TicketEvent[]
  notifications Notification[]
  slaSignals    TicketSlaSignal[]
  deliveries    NotificationDelivery[]

  @@index([status])
  @@index([priority])
  @@index([teamId, status])
  @@index([assigneeId, status])
  @@index([orgId, status])
  @@index([requesterId])
  @@index([firstReplyDueAt])
  @@index([resolveDueAt])
  @@index([createdAt])
  /// SLA scan: active tickets whose at-risk instant has passed (or is missing: backfill).
  @@index([status, firstReplyAtRiskAt])
  @@index([status, resolveAtRiskAt])
}

model Message {
  id           String      @id @default(uuid()) @db.Uuid
  ticketId     String      @db.Uuid
  /// Null for SYSTEM messages.
  authorId     String?     @db.Uuid
  type         MessageType
  body         String
  /// Client-generated temp ID used to reconcile optimistic UI; unique per ticket (idempotency).
  clientTempId String?
  createdAt    DateTime    @default(now())

  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@unique([ticketId, clientTempId])
  @@index([ticketId, createdAt])
}

model Attachment {
  id         String               @id @default(uuid()) @db.Uuid
  ticketId   String?              @db.Uuid
  messageId  String?              @db.Uuid
  uploaderId String               @db.Uuid
  storageKey String               @unique
  fileName   String
  mimeType   String
  sizeBytes  Int
  status     AttachmentStatus     @default(PENDING)
  visibility AttachmentVisibility @default(PUBLIC)
  createdAt  DateTime             @default(now())

  ticket   Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([messageId])
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets TicketTag[]
}

model TicketTag {
  ticketId String @db.Uuid
  tagId    String @db.Uuid

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([ticketId, tagId])
  @@index([tagId])
}

/// Append-only history of every ticket change.
model TicketEvent {
  id        String          @id @default(uuid()) @db.Uuid
  ticketId  String          @db.Uuid
  /// Null when the change was made by the system (SLA worker, auto-close, escalation).
  actorId   String?         @db.Uuid
  type      TicketEventType
  fromValue String?
  toValue   String?
  meta      Json?
  createdAt DateTime        @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([type, createdAt])
}

/// Exactly-once SLA alerts across workers: the SLA scan inserts the signal first, and only the
/// worker whose insert succeeded writes the TicketEvent, updates the summary flags
/// (`Ticket.slaAtRiskAt` / `slaBreached` / `slaBreachedAt`) and sends notifications. `dueAt` is
/// the target's due date when the threshold was crossed, so a moved due date (priority change,
/// PENDING resume) is a new signal.
model TicketSlaSignal {
  id         String        @id @default(uuid()) @db.Uuid
  ticketId   String        @db.Uuid
  target     SlaTarget
  kind       SlaSignalKind
  dueAt      DateTime
  createdAt  DateTime      @default(now())
  /// A fresh crossing (D10) that must be announced; set in the inserting transaction.
  notify     Boolean       @default(false)
  /// When its announcement was enqueued. A `notify` signal still null here after the commit
  /// (Redis down, worker killed) is re-enqueued by later scans for up to 60 minutes (the job id
  /// is deterministic, so a double enqueue is a no-op).
  enqueuedAt DateTime?

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, target, kind, dueAt])
  /// SLA scan: announcements still to enqueue.
  @@index([notify, enqueuedAt, createdAt])
}

// ───────────────────────────── Configuration ─────────────────────────────

model Category {
  id                 String   @id @default(uuid()) @db.Uuid
  key                String   @unique
  labelEn            String
  labelAr            String   @default("")
  /// lucide-react icon name.
  icon               String   @default("circle-question-mark")
  /// Example shown in the Asset / device ID input (e.g. "e.g. CAM-014").
  assetPlaceholder   String?
  /// Arabic example for the same input; null = the English one is shown (bidi-isolated).
  assetPlaceholderAr String?
  teamId             String   @db.Uuid
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  team     Team            @relation(fields: [teamId], references: [id], onDelete: Restrict)
  subtypes Subtype[]
  fields   CategoryField[]
  skills   CategorySkill[]
  tickets  Ticket[]

  @@index([isActive, sortOrder])
}

model Subtype {
  id              String   @id @default(uuid()) @db.Uuid
  categoryId      String   @db.Uuid
  key             String
  labelEn         String
  labelAr         String   @default("")
  defaultPriority Priority @default(P3)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tickets  Ticket[]

  @@unique([categoryId, key])
  @@index([categoryId, isActive, sortOrder])
}

model CustomField {
  id            String          @id @default(uuid()) @db.Uuid
  key           String          @unique
  labelEn       String
  labelAr       String          @default("")
  type          CustomFieldType
  /// For DROPDOWN / MULTI_SELECT: [{ "value": "...", "labelEn": "...", "labelAr": "..." }].
  options       Json?
  placeholderEn String?
  placeholderAr String?
  required      Boolean         @default(false)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  categories CategoryField[]
}

model CategoryField {
  categoryId String @db.Uuid
  fieldId    String @db.Uuid
  sortOrder  Int    @default(0)

  category Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  field    CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([categoryId, fieldId])
  @@index([fieldId])
}

model SlaPolicy {
  id                String   @id @default(uuid()) @db.Uuid
  priority          Priority @unique
  /// Minutes of (business or calendar) time allowed for the first public agent reply.
  firstReplyMins    Int
  /// Minutes of (business or calendar) time allowed until SOLVED. PENDING pauses this clock.
  resolveMins       Int
  /// When true only business hours (minus holidays) count; otherwise the clock runs 24/7.
  businessHoursOnly Boolean
  /// Percentage of the window after which the ticket is flagged "SLA at risk".
  atRiskPercent     Int      @default(75)
  updatedAt         DateTime @updatedAt
}

model BusinessHours {
  id        String   @id @default(uuid()) @db.Uuid
  /// 0 = Sunday … 6 = Saturday.
  weekday   Int      @unique
  isOpen    Boolean  @default(true)
  /// "HH:mm" in the configured business timezone (AppSetting "business.timezone").
  open      String   @default("07:30")
  close     String   @default("16:30")
  /// Optimistic concurrency for admin edits (E19).
  updatedAt DateTime @default(now()) @updatedAt
}

/// Archived with `isActive = false` like every config record (the SLA calendar must ignore
/// archived days). `date` stays unique across archived rows too: re-adding an archived date means
/// restoring that row (isActive = true, new name), not inserting a second one.
model Holiday {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @unique @db.Date
  name      String
  nameAr    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  /// Optimistic concurrency for admin edits (E19).
  updatedAt DateTime @default(now()) @updatedAt
}

/// P1 escalation chain (spec §9). Team-scoped rules (teamId set), when a team has any active ones,
/// replace the global chain (teamId = null) for that team.
model EscalationRule {
  id           String               @id @default(uuid()) @db.Uuid
  priority     Priority
  /// Null = applies to every team.
  teamId       String?              @db.Uuid
  step         Int
  targetType   EscalationTargetType
  targetRole   Role?
  targetUserId String?              @db.Uuid
  /// Minutes after the ticket became P1 (`Ticket.p1Since`: creation, or a later upgrade), counted
  /// cumulatively — not from the previous step (seeded chain: 0, 5, 15). Steps only fire while the
  /// ticket is still P1, active and unacknowledged. Downgrading from P1 cancels the chain.
  afterMins    Int
  channels     EscalationChannel[]
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  team       Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  targetUser User? @relation(fields: [targetUserId], references: [id], onDelete: SetNull)

  /// One rule per step of a chain. The migration creates it NULLS NOT DISTINCT (hand-written SQL),
  /// so the global chain (teamId = null) can't have two rules for the same step either.
  @@unique([priority, teamId, step])
  @@index([priority, isActive])
}

model Macro {
  id          String        @id @default(uuid()) @db.Uuid
  key         String        @unique
  /// Null = available to every team.
  teamId      String?       @db.Uuid
  titleEn     String
  titleAr     String        @default("")
  bodyEn      String
  bodyAr      String        @default("")
  /// Optional status applied when the macro is sent.
  setStatus   TicketStatus?
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  team      Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([teamId, isActive, sortOrder])
}

/// Editable subject/body text with {{variables}}; the HTML layout stays in code.
model EmailTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  subjectEn   String
  bodyEn      String
  subjectAr   String   @default("")
  bodyAr      String   @default("")
  /// Variables available to this template (documentation for the admin editor).
  variables   String[] @default([])
  isActive    Boolean  @default(true)
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model HelpArticle {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  titleEn     String
  titleAr     String   @default("")
  bodyEn      String
  bodyAr      String   @default("")
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, isPublished, sortOrder])
}

/// Key/value settings edited in the admin panel (e.g. business.timezone, tickets.autoCloseDays).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ───────────────────────────── Activity ─────────────────────────────

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  ticketId  String?          @db.Uuid
  /// Optional: the web renders notifications in the viewer's language from `type` + `data`.
  title     String?
  body      String?
  data      Json?
  readAt    DateTime?
  /// Idempotency key of the producing job (one per event × recipient): a retry that finds it taken
  /// creates nothing. Read notifications older than 90 days are deleted.
  dedupeKey String?          @unique
  createdAt DateTime         @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([ticketId])
}

/// Log of outbound email / Teams / SMS notifications (spec §9 "dead-letter logging"): one row per
/// channel × recipient × event, keyed by `dedupeKey` so a retried job updates its own row and never
/// sends twice. Recipients are stored masked: e-mail addresses as is, phone numbers masked, Teams
/// webhooks as their host only (the URL is a secret). `error` is redacted. Kept 90 days.
model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  channel           NotificationChannel
  /// EmailTemplate key (or the Teams / SMS message kind, e.g. P1_ALERT).
  templateKey       String
  ticketId          String?                    @db.Uuid
  userId            String?                    @db.Uuid
  /// Set for team-level deliveries (distribution list, Teams channel, digest).
  teamId            String?                    @db.Uuid
  recipientMasked   String
  status            NotificationDeliveryStatus @default(QUEUED)
  providerMessageId String?
  error             String?
  dedupeKey         String                     @unique
  attempts          Int                        @default(0)
  createdAt         DateTime                   @default(now())
  sentAt            DateTime?

  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([userId])
  @@index([teamId])
  @@index([createdAt])
}

/// Append-only log of admin writes (decision E17), written in the same transaction as the change.
/// `before` / `after` hold the changed fields only, redacted: secrets never stored (a Teams webhook
/// becomes its host), phone numbers masked, and never passwordHash / mfaSecret / sessionVersion.
/// The API has no endpoint that updates or deletes rows.
model AdminAuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  actorId     String?     @db.Uuid
  action      AuditAction
  /// The Prisma model name (e.g. "Category", "TeamMember"), see AUDIT_ENTITIES in @loons/shared.
  entity      String
  entityId    String
  /// A human label of the entity at the time of the change (e.g. the English name), for the viewer.
  entityLabel String?
  /// The API request id (x-request-id) of the write.
  requestId   String?
  before      Json?
  after       Json?
  createdAt   DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entity, createdAt])
}

// ───────────────────────────── Skills & auto-assignment ─────────────────────────────

/// A thing staff can be good at ("Network", "CCTV"). Managed by super admins; archived, never deleted.
/// A category lists the skills it needs (CategorySkill); a staff member lists the skills they have
/// (UserSkill). A new ticket in a category with skills goes to the best-matching person on its team.
model Skill {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  labelEn   String
  labelAr   String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      UserSkill[]
  categories CategorySkill[]

  @@index([isActive])
}

model UserSkill {
  userId    String   @db.Uuid
  skillId   String   @db.Uuid
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([userId, skillId])
  @@index([skillId])
}

model CategorySkill {
  categoryId String   @db.Uuid
  skillId    String   @db.Uuid
  createdAt  DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([categoryId, skillId])
  @@index([skillId])
}
