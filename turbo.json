{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".env"
  ],
  "globalPassThroughEnv": [
    "*"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "@loons/db#db:generate"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "@loons/db#db:generate"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "@loons/db#db:generate"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "@loons/db#db:generate"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "@loons/db#db:generate"
      ],
      "cache": false
    },
    "@loons/db#db:generate": {
      "inputs": [
        "prisma/schema.prisma",
        "prisma.config.ts"
      ],
      "outputs": [
        "src/generated/**"
      ]
    },
    "dev:worker": {
      "dependsOn": [
        "@loons/db#db:generate"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
