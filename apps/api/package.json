{
  "name": "@loons/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -v NODE_ENV=development -- tsx watch --clear-screen=false src/server.ts",
    "dev:worker": "dotenv -e ../../.env -v NODE_ENV=development -- tsx watch --clear-screen=false src/worker.ts",
    "start": "tsx src/server.ts",
    "start:worker": "tsx src/worker.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env -v NODE_ENV=test -- vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/client-sesv2": "catalog:",
    "@aws-sdk/client-sns": "catalog:",
    "@aws-sdk/s3-presigned-post": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@fastify/cookie": "catalog:",
    "@fastify/cors": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/proxy-addr": "catalog:",
    "@fastify/rate-limit": "catalog:",
    "@fastify/swagger": "catalog:",
    "@fastify/swagger-ui": "catalog:",
    "@loons/db": "workspace:*",
    "@loons/emails": "workspace:*",
    "@loons/shared": "workspace:*",
    "@node-rs/argon2": "catalog:",
    "@socket.io/redis-adapter": "catalog:",
    "bullmq": "catalog:",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "ioredis": "catalog:",
    "jose": "catalog:",
    "nodemailer": "catalog:",
    "pino": "catalog:",
    "socket.io": "catalog:",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@loons/eslint-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "dotenv-cli": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "catalog:",
    "socket.io-client": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
