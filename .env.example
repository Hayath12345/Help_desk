# ─────────────────────────────────────────────────────────────────────────────
# Loons Help Desk — environment variables
#
# Copy to `.env` in the repo root: `cp .env.example .env`. Every app reads this one file.
# Local defaults below match docker-compose.yml. For AWS, swap the values noted "AWS:"
# — no code changes are needed.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

# NODE_ENV is intentionally not set here. next dev/build set it themselves, the API's dev/test scripts
# set development/test, and an unset NODE_ENV is treated as production by the API (fail-safe).
# (A development NODE_ENV during `next build` breaks prerendering.)

# ── URLs ─────────────────────────────────────────────────────────────────────
# Public URL of the web app (links in emails, Teams cards, password reset).
APP_URL=http://localhost:3000
# API base URL as seen from the web server (server components, Auth.js callbacks).
API_INTERNAL_URL=http://localhost:4000
# API base URL as seen from the browser (REST + Socket.IO).
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Database ─────────────────────────────────────────────────────────────────
# AWS: RDS endpoint with full TLS verification against the RDS CA bundle, e.g.
#   postgresql://user:pass@<rds-endpoint>:5432/loons?sslmode=verify-full&sslrootcert=/app/certs/rds-global-bundle.pem
# (node-postgres treats sslmode=require as verify-full, and the RDS CA is not in Node's default trust store —
#  the Phase 6 images ship the bundle; see the deployment guide.)
DATABASE_URL=postgresql://loons:loons@localhost:5432/loons_helpdesk
# Max pool connections per API/worker process (default 10).
DATABASE_POOL_SIZE=10

# ── Redis (AWS: ElastiCache endpoint, rediss:// for TLS) ─────────────────────
REDIS_URL=redis://localhost:6379
# Use the Socket.IO Redis adapter (required when running more than one API instance).
SOCKET_REDIS_ADAPTER=true

# ── Web authentication (Auth.js) ─────────────────────────────────────────────
# Secret used to encrypt the Auth.js session cookie.
# AUTH_SECRET, API_JWT_SECRET and INTERNAL_API_KEY must be replaced — the apps refuse to start with the placeholders.
AUTH_SECRET=replace-me-with-32+-random-bytes
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Google sign-in for clients. Leave empty to hide the Google button.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Microsoft Entra ID sign-in for staff. Leave empty to disable.
# Issuer MUST be tenant-specific: https://login.microsoftonline.com/<tenant-id-guid>/v2.0
# (common/organizations/consumers are rejected so only your tenant's accounts can sign in).
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# Only this email domain is treated as Loons staff.
STAFF_EMAIL_DOMAIN=loonsgroup.com
# DEVELOPMENT ONLY: lets seeded staff sign in with a password when Entra ID is not configured.
# Ignored (always off) when NODE_ENV=production. Must be enabled in BOTH web and API.
AUTH_DEV_STAFF_LOGIN=true
# Number of reverse proxies in front of the web app that append to X-Forwarded-For (1 = one AWS ALB).
# The client IP (used for sign-in rate limits) is read that many entries from the right.
# 0 = nothing in front of Next.js: the client IP is then unknown and only the per-email limits apply.
TRUSTED_PROXY_HOPS=1

# ── Web → API tokens ─────────────────────────────────────────────────────────
# HS256 secret shared by web (signs) and API (verifies) for short-lived access tokens.
API_JWT_SECRET=replace-me-with-32+-random-bytes
API_JWT_ISSUER=loons-web
API_JWT_AUDIENCE=loons-api
API_TOKEN_TTL_SECONDS=900
# Server-to-server key for /internal/* API routes (web server only; never sent to browsers).
INTERNAL_API_KEY=replace-me-with-32+-random-bytes

# ── API server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Proxies in front of the API whose X-Forwarded-For entries are trusted for client IPs:
#   false (default, no proxy) · a hop count (1 = one AWS ALB) · or a comma list of proxy IPs/CIDRs.
# `true` is rejected: it would trust whatever X-Forwarded-For a client sends.
TRUST_PROXY=false
LOG_LEVEL=info
# Reported by /health (defaults to the API package version).
APP_VERSION=

# ── File storage (AWS: S3 — leave S3_ENDPOINT empty, S3_FORCE_PATH_STYLE=false) ─
S3_REGION=me-central-1
S3_BUCKET=loons-helpdesk-attachments
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# Local MinIO credentials. On AWS leave empty to use the IAM role / default credential chain.
S3_ACCESS_KEY_ID=loons
S3_SECRET_ACCESS_KEY=loons-local-secret
UPLOAD_MAX_BYTES=26214400

# ── Email (EMAIL_PROVIDER=smtp locally → Mailpit, ses on AWS) ────────────────
EMAIL_PROVIDER=smtp
EMAIL_FROM="Loons Support <support@loonsgroup.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SES_REGION=me-central-1

# ── SMS (SMS_PROVIDER=console locally, sns on AWS) ───────────────────────────
SMS_PROVIDER=console
SNS_REGION=me-central-1
SMS_SENDER_ID=LOONS

# ── Seed ─────────────────────────────────────────────────────────────────────
# Password given to every seeded demo user (clients, and staff when AUTH_DEV_STAFF_LOGIN=true).
SEED_DEMO_PASSWORD=LoonsDemo2026
# Seed demo organisations, users and tickets (opt-in; never in production).
SEED_DEMO_DATA=true
# Optional: create the first SUPER_ADMIN (SSO-only, no password) on a fresh/production install.
# Must be an address on STAFF_EMAIL_DOMAIN. They sign in with Microsoft Entra ID.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=

# ── Tests only ───────────────────────────────────────────────────────────────
# API integration tests: log level (default silent) and Mailpit API used to assert delivered email.
TEST_LOG_LEVEL=silent
MAILPIT_API_URL=http://localhost:8025/api/v1
