# ─────────────────────────────────────────────────────────────────────────────
# Loons Help Desk — environment variables
#
# Copy to `.env` in the repo root: `cp .env.example .env`. Every app reads this one file.
# Local defaults below match docker-compose.yml. For AWS, swap the values noted "AWS:"
# — no code changes are needed.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

# NODE_ENV is intentionally not set here. next dev/build set it themselves, the API's dev/test scripts
# and `pnpm db:seed` set development/test, and an unset NODE_ENV is treated as production by the API and
# the seed (fail-safe). (A development NODE_ENV during `next build` breaks prerendering.)
#
# Boolean variables accept true/1/yes/on or false/0/no/off (any case); any other value stops the app
# with a configuration error instead of guessing.

# ── URLs ─────────────────────────────────────────────────────────────────────
# Public URL of the web app (links in emails, Teams cards, password reset).
APP_URL=http://localhost:3000
# API base URL as seen from the web server (server components, Auth.js callbacks).
API_INTERNAL_URL=http://localhost:4000
# API base URL as seen from the browser (REST + Socket.IO).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Origin the browser uploads attachments to (pre-signed POST) — allowed in the web CSP connect-src.
# Local MinIO: http://localhost:9000 · AWS: https://<bucket>.s3.<region>.amazonaws.com
NEXT_PUBLIC_UPLOAD_ORIGIN=http://localhost:9000

# ── Database ─────────────────────────────────────────────────────────────────
# AWS: RDS endpoint with full TLS verification against the RDS CA bundle, e.g.
#   postgresql://user:pass@<rds-endpoint>:5432/loons?sslmode=verify-full&sslrootcert=/app/certs/rds-global-bundle.pem
# (node-postgres treats sslmode=require as verify-full, and the RDS CA is not in Node's default trust store —
#  the Phase 6 images ship the bundle; see the deployment guide.)
DATABASE_URL=postgresql://loons:loons@localhost:5432/loons_helpdesk
# Max pool connections per API/worker process (default 10).
DATABASE_POOL_SIZE=10

# ── Redis (AWS: ElastiCache endpoint, rediss:// for TLS) ─────────────────────
REDIS_URL=redis://localhost:6379
# Use the Socket.IO Redis adapter (required when running more than one API instance).
SOCKET_REDIS_ADAPTER=true

# ── Web authentication (Auth.js) ─────────────────────────────────────────────
# Secret used to encrypt the Auth.js session cookie.
# AUTH_SECRET, API_JWT_SECRET and INTERNAL_API_KEY must be replaced — the apps refuse to start with the placeholders.
AUTH_SECRET=replace-me-with-32+-random-bytes
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Google sign-in for clients. Leave empty to hide the Google button.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Microsoft Entra ID sign-in for staff. Leave empty to disable.
# Issuer MUST be tenant-specific: https://login.microsoftonline.com/<tenant-id-guid>/v2.0
# (common/organizations/consumers are rejected so only your tenant's accounts can sign in).
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# Only this email domain is treated as Loons staff.
STAFF_EMAIL_DOMAIN=loonsgroup.com
# DEVELOPMENT ONLY: lets seeded staff sign in with a password when Entra ID is not configured.
# Ignored (always off) when NODE_ENV=production. Must be enabled in BOTH web and API.
AUTH_DEV_STAFF_LOGIN=true
# Number of reverse proxies in front of the web app that append to X-Forwarded-For (1 = one AWS ALB).
# The client IP (used for sign-in rate limits) is read that many entries from the right.
# 0 = nothing in front of Next.js (development only; the web app refuses to start with 0 when
#     NODE_ENV=production): the client IP is then unknown, so the API skips its per-IP auth limits (never one
#     shared bucket for everyone) and applies the per-email / per-account limits plus shared caps for unknown IPs.
TRUSTED_PROXY_HOPS=1

# ── Web → API tokens ─────────────────────────────────────────────────────────
# HS256 secret shared by web (signs) and API (verifies) for short-lived access tokens.
API_JWT_SECRET=replace-me-with-32+-random-bytes
API_JWT_ISSUER=loons-web
API_JWT_AUDIENCE=loons-api
# Access-token lifetime in seconds: an integer from 60 to 3600 (both apps refuse anything else).
API_TOKEN_TTL_SECONDS=900
# Server-to-server key for /internal/* API routes (web server only; never sent to browsers).
INTERNAL_API_KEY=replace-me-with-32+-random-bytes

# ── API server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Proxies in front of the API whose X-Forwarded-For entries are trusted for client IPs:
#   false (default, no proxy) · a hop count (1 = one AWS ALB) · or a comma list of proxy IPs/CIDRs.
# `true` is rejected: it would trust whatever X-Forwarded-For a client sends.
TRUST_PROXY=false
# Socket.IO limits, per API instance (blank = the default shown). Per-address limits use the
# client address as TRUST_PROXY resolves it (IPv6 by its /64, IPv4-mapped IPv6 as IPv4), so an
# office behind one NAT shares them: raise them for large offices. Positive integers only.
#   sockets one user may have open (tabs, plus old sockets not yet timed out after a reconnect)
REALTIME_SOCKETS_PER_USER=20
#   sockets one client address may have open
REALTIME_SOCKETS_PER_IP=500
#   new connections per client address: a burst, then this many per second (refused with 403
#   at the upgrade; sized for a NAT full of browsers reconnecting after an API restart)
REALTIME_HANDSHAKES_PER_IP_BURST=200
REALTIME_HANDSHAKES_PER_IP_PER_SECOND=20
#   connections per client address still waiting for their Socket.IO handshake (closed after 10 s)
REALTIME_PENDING_CONNECTIONS_PER_IP=50
LOG_LEVEL=info
# Reported by /health (defaults to the API package version).
APP_VERSION=

# ── File storage (AWS: S3 — leave S3_ENDPOINT empty, S3_FORCE_PATH_STYLE=false) ─
S3_REGION=me-central-1
# The bucket needs a lifecycle rule expiring the `attachments/` prefix (browser uploads) after
# 1 day; docker-compose's minio-init adds it locally, S3 needs it configured (see docs).
S3_BUCKET=loons-helpdesk-attachments
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# Local MinIO credentials. On AWS leave empty to use the IAM role / default credential chain.
S3_ACCESS_KEY_ID=loons
S3_SECRET_ACCESS_KEY=loons-local-secret
UPLOAD_MAX_BYTES=26214400
# Upload budget per user over a rolling 24 hours, in the bytes declared at presign (a positive
# integer; blank = 2 GiB). Beyond it POST /attachments/presign answers 429 RATE_LIMITED with
# details { reason: 'daily-quota', limitBytes, retryAfterSeconds }. Presigned uploads that are
# later rejected or never sent still count.
UPLOAD_DAILY_BYTES_PER_USER=2147483648

# ── Email (EMAIL_PROVIDER=smtp locally → Mailpit, ses on AWS) ────────────────
EMAIL_PROVIDER=smtp
EMAIL_FROM="Loons Support <support@loonsgroup.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SES_REGION=me-central-1

# ── SMS (SMS_PROVIDER=console locally, sns on AWS) ───────────────────────────
SMS_PROVIDER=console
SNS_REGION=me-central-1
SMS_SENDER_ID=LOONS
# Texts one phone number may receive per rolling hour (P1 pages, escalations); beyond it the SMS
# is recorded as SKIPPED and the email / in-app notification still go. Integer 1–1000; blank = 20.
# One organisation's P1s may use at most a quarter of it (5 of 20), so a single customer's P1 flood
# can't silence pages for everyone else.
SMS_MAX_PER_RECIPIENT_PER_HOUR=20

# ── Microsoft Teams (TEAMS_PROVIDER=console locally, webhook in production) ───
# console: logs one line per card (title and webhook host, never the URL) and records the
# delivery. webhook: POSTs the Adaptive Card to the team's incoming-webhook / Power Automate URL
# (Team.teamsWebhookUrl — a secret, never logged or sent to browsers), HTTPS only.
TEAMS_PROVIDER=console
# Hosts a webhook URL may point at, comma-separated: `host` or `*.domain` (sub-domains only).
# Blank = *.webhook.office.com, *.logic.azure.com, *.environment.api.powerplatform.com.
TEAMS_WEBHOOK_HOSTS=
# Webhook request timeout in ms (1000–60000; blank = 10000).
TEAMS_TIMEOUT_MS=10000

# ── Worker ───────────────────────────────────────────────────────────────────
# true (default): the worker registers the repeatable jobs (SLA scan every minute, auto-close
# every 15 min, P4 digest at AppSetting notifications.p4DigestTime in business.timezone on
# business days, orphan-upload sweep every 30 min, retention daily). false: it only consumes
# jobs — for extra workers (e.g. the one Playwright starts next to `pnpm dev`).
WORKER_SCHEDULERS=true

# ── Seed ─────────────────────────────────────────────────────────────────────
# Password given to every seeded demo user (clients, and staff when AUTH_DEV_STAFF_LOGIN=true).
SEED_DEMO_PASSWORD=LoonsDemo2026
# Seed demo organisations, users and tickets (opt-in; never in production). Demo data is only added when this
# is true AND NODE_ENV is explicitly development or test — an unset or any other NODE_ENV counts as production.
# `pnpm db:seed` defaults NODE_ENV to development only when it is unset (LOONS_DEFAULT_NODE_ENV); a production
# seed runs with NODE_ENV=production (Phase 6) and never adds demo data.
SEED_DEMO_DATA=true
# Optional: create the first SUPER_ADMIN (SSO-only, no password) on a fresh/production install.
# Must be an address on STAFF_EMAIL_DOMAIN. They sign in with Microsoft Entra ID.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=

# ── Tests only ───────────────────────────────────────────────────────────────
# API integration tests: log level (default silent) and Mailpit API used to assert delivered email.
TEST_LOG_LEVEL=silent
MAILPIT_API_URL=http://localhost:8025/api/v1
