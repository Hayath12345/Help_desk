# ─────────────────────────────────────────────────────────────────────────────
# Loons Help Desk — PRODUCTION environment variables (AWS)
#
# This file is a TEMPLATE, not something to load: nothing here is a real secret. Values are what
# the AWS deployment sets; "replace-me" values and <angle-bracket> values must be filled in. What the
# apps check at start-up: API_JWT_SECRET, INTERNAL_API_KEY and AUTH_SECRET are refused while they
# still look like a placeholder, and DATABASE_URL / REDIS_URL are refused while they contain "<"
# or ">" or "replace-me". No other value is checked for placeholders - read every line. Values
# are written WITHOUT quotes: put them into the task definition exactly as shown (quotes would
# become part of the value). docs/DEPLOYMENT.md has the same list as a table and explains where each
# value comes from.
#
# Every variable has a header line:   # [<who reads it> | <kind>] what it is
#   who:  web · api · worker · migrate (the migrate image: migrations and the production seed)
#   kind: secret — store in AWS Secrets Manager (or SSM Parameter Store SecureString) and inject
#                  it into the task / pod as a secret; never in the task definition in clear text,
#                  never in an image, never in a build argument.
#         plain  — safe to put in the task definition / ConfigMap.
#         build  — baked into the web image at build time (docker build --build-arg); changing it
#                  means rebuilding the web image.
# A test (apps/api/src/env-docs.test.ts) keeps this file, config.ts and docs/DEPLOYMENT.md in step.
#
# Boolean variables accept true/1/yes/on or false/0/no/off. Blank = the default in the comment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Mode ─────────────────────────────────────────────────────────────────────

# [web api worker migrate | plain] Always production on AWS (the images set it; never development).
# On an ECS / Fargate runtime any other value is refused at start-up.
NODE_ENV=production
# [web api worker | plain] aws = the strict production rules (HTTPS, TLS to database and Redis,
# IAM-role S3, SES / SNS / Teams providers, proxy trust). rehearsal switches them off and is for
# docker-compose.prod.yml only: NEVER set it on AWS (an ECS / Fargate runtime refuses it).
DEPLOY_PROFILE=aws
# [api worker | plain] debug and trace log more detail; logs never contain personal data.
LOG_LEVEL=info
# [api worker | plain] Reported by /health. Blank = the API package version; set it to the release tag.
APP_VERSION=
# [api | plain] Swagger UI and the OpenAPI document (/docs, /docs/json). Blank = off in production,
# on elsewhere. Keep it off on AWS: the document lists every route, /internal/* included. (The load
# balancer listener also blocks /docs* and /internal/*, docs/DEPLOYMENT.md section 5.)
API_DOCS_ENABLED=false

# ── URLs ─────────────────────────────────────────────────────────────────────

# [api worker | plain] Public https URL of the web app (links in emails and Teams cards).
APP_URL=https://help.example.com
# [web | plain] Public https URL of the web app for Auth.js (OAuth callbacks); same as APP_URL.
AUTH_URL=https://help.example.com
# [web | plain] Required behind the load balancer: Auth.js trusts the forwarded host header.
AUTH_TRUST_HOST=true
# [web | plain] API base URL as seen from the web server: the internal address of the API service
# (service discovery / internal load balancer). Plain http inside the VPC is fine.
API_INTERNAL_URL=http://api.loons.internal:4000
# [web | build] API base URL as seen from the browser (REST + Socket.IO): the https address of the
# API on the load balancer. Also allowed in the web CSP connect-src.
NEXT_PUBLIC_API_URL=https://api.help.example.com
# [web | build] Origin the browser uploads attachments to (pre-signed POST):
# https://<bucket>.s3.<region>.amazonaws.com
NEXT_PUBLIC_UPLOAD_ORIGIN=https://loons-helpdesk-attachments.s3.me-central-1.amazonaws.com
# [web | plain] Development servers only (`next dev`): hostnames or IPs other devices use to reach it.
# Leave empty in production: `next start` and the standalone server ignore it.
DEV_ALLOWED_ORIGINS=
# [api worker | plain] Comma-separated https origins of the web app that may call the API from a
# browser. (The worker runs the same configuration check, so it needs the value too.)
CORS_ORIGINS=https://help.example.com

# ── API server ───────────────────────────────────────────────────────────────

# [api | plain] Listen address inside the container.
API_HOST=0.0.0.0
# [api | plain] Listen port inside the container.
API_PORT=4000
# [web | plain] Port and host of the Next.js standalone server (the web image sets both).
PORT=3000
HOSTNAME=0.0.0.0
# [api worker | plain] Proxies in front of the API whose X-Forwarded-For is trusted: 1 behind one
# load balancer, 2 with CloudFront in front of it (3 is the most accepted), or the VPC CIDR.
# Required in production (blank/false is refused). The worker only checks it.
TRUST_PROXY=1
# [web | plain] Proxies in front of the web app that append to X-Forwarded-For: 1 behind one
# load balancer, 2 with CloudFront in front of it (3 is the most accepted). 0 is refused in production.
TRUSTED_PROXY_HOPS=1
# [api | plain] Socket.IO limits per API instance (blank = the defaults shown).
REALTIME_SOCKETS_PER_USER=20
REALTIME_SOCKETS_PER_IP=500
REALTIME_HANDSHAKES_PER_IP_BURST=200
REALTIME_HANDSHAKES_PER_IP_PER_SECOND=20
REALTIME_PENDING_CONNECTIONS_PER_IP=50

# ── Database (RDS PostgreSQL) ────────────────────────────────────────────────

# [api worker migrate | secret] RDS endpoint with verified TLS; the whole URL is one secret (it holds
# the password). PERCENT-ENCODE the user name and password: # is %23, @ is %40, / is %2F, ? is %3F,
# % is %25, : is %3A (or use an alphanumeric password; the apps refuse an unencoded special
# character). Exactly one sslmode, and it must be verify-full. The CA files are added to the images
# from deploy/certs (docs/DEPLOYMENT.md, "The RDS CA bundle"): sslmode=verify-full and sslrootcert
# (the whole RDS bundle) are read by node-postgres (API, worker); sslcert and sslaccept=strict make
# Prisma Migrate verify the certificate too. Prisma ignores sslrootcert and reads only the FIRST
# certificate of sslcert, so rds-ca.pem is a file holding ONE certificate: the root that signed
# your instance's chain. Not tested against a real RDS.
DATABASE_URL=postgresql://loons:replace-me-password@<rds-endpoint>:5432/loons?sslmode=verify-full&sslrootcert=/app/certs/rds-global-bundle.pem&sslcert=/app/certs/rds-ca.pem&sslaccept=strict
# [api worker | plain] Max pool connections per process. Keep (API tasks + worker tasks) x this
# well below the RDS max_connections.
DATABASE_POOL_SIZE=10

# ── Redis (ElastiCache) ──────────────────────────────────────────────────────

# [api worker | secret] ElastiCache endpoint with in-transit encryption (rediss://) and the auth
# token or the user:password of an ElastiCache user; one secret. Percent-encode the password as
# for DATABASE_URL. Use a replication group with CLUSTER MODE DISABLED (one primary endpoint; the
# code does not speak the cluster protocol). The client opens with RESP3 (HELLO 3) and falls back
# to RESP2 itself if the engine refuses it (lib/redis.ts). Not tested against ElastiCache.
REDIS_URL=rediss://default:replace-me-token@<elasticache-primary-endpoint>:6379
# [api worker | plain] Socket.IO Redis adapter: must be true on AWS (refused otherwise): a service
# can be scaled past one API task at any time. The worker only checks it.
SOCKET_REDIS_ADAPTER=true
# [api worker | plain] Namespace of every Redis key, queue and channel. Blank = loons. Give every
# deployment that shares one Redis its own (staging, production).
REDIS_KEY_PREFIX=loons

# ── Web authentication (Auth.js) ─────────────────────────────────────────────

# [web | secret] Encrypts the session cookie. Three different random values for AUTH_SECRET,
# API_JWT_SECRET and INTERNAL_API_KEY (>= 32 characters each). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-me-with-32+-random-bytes
# [web | secret] Optional session-secret rotation: put the previous AUTH_SECRET here while rolling
# a new one out, then clear it.
AUTH_SECRET_1=
AUTH_SECRET_2=
AUTH_SECRET_3=
# [web | secret] Google sign-in for clients. Leave both empty to hide the Google button.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# [web | secret] Microsoft Entra ID sign-in for staff. The issuer must be tenant-specific:
# https://login.microsoftonline.com/<tenant-id-guid>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# [web api migrate | plain] Only this email domain is treated as Loons staff.
STAFF_EMAIL_DOMAIN=loonsgroup.com
# [web api | plain] Development-only staff password form. Ignored in production; leave false.
AUTH_DEV_STAFF_LOGIN=false

# ── Web → API tokens ─────────────────────────────────────────────────────────

# [web api worker | secret] HS256 secret shared by web (signs) and API (verifies) the short-lived
# tokens. (The worker runs the same configuration check, so it needs the value too.)
API_JWT_SECRET=replace-me-with-32+-random-bytes
# [web api worker | plain] Token issuer and audience; the same in web and API (and checked by the worker).
API_JWT_ISSUER=loons-web
API_JWT_AUDIENCE=loons-api
# [web api | plain] Access-token lifetime in seconds (60 to 3600).
API_TOKEN_TTL_SECONDS=900
# [web api worker | secret] Server-to-server key for /internal/* routes (web server only; the worker
# only checks it).
INTERNAL_API_KEY=replace-me-with-32+-random-bytes

# ── File storage (S3) ────────────────────────────────────────────────────────

# [api worker | plain] Region of the attachments bucket (me-central-1 or me-south-1).
S3_REGION=me-central-1
# [api worker | plain] Private, unversioned bucket with the lifecycle rule and CORS (docs/DEPLOYMENT.md).
S3_BUCKET=loons-helpdesk-attachments
# [api worker | plain] AWS S3 only: leave these four empty / false. A custom endpoint or static
# keys are refused in production; the task role provides the credentials.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# [api worker | plain] Largest single upload in bytes (blank = 26214400, 25 MiB).
UPLOAD_MAX_BYTES=26214400
# [api | plain] Upload budget per user over a rolling 24 hours, in bytes (blank = 2 GiB).
UPLOAD_DAILY_BYTES_PER_USER=2147483648

# ── Email (SES) ──────────────────────────────────────────────────────────────

# [api worker | plain] ses on AWS (smtp is refused in production).
EMAIL_PROVIDER=ses
# [api worker | plain] From address; its domain (or the address) must be a verified SES identity in SES_REGION.
EMAIL_FROM=Loons Support <support@loonsgroup.com>
# [api worker | plain] Region whose SES endpoint sends the mail. Use another region if SES is not
# offered in the main one (docs/DEPLOYMENT.md, "Regions").
SES_REGION=me-central-1
# [api worker | plain] SMTP settings: only for EMAIL_PROVIDER=smtp (local development). Unused on AWS.
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
# [api worker | secret] Unused on AWS.
SMTP_PASSWORD=

# ── SMS (SNS) ────────────────────────────────────────────────────────────────

# [api worker | plain] sns on AWS (console is refused in production).
SMS_PROVIDER=sns
# [api worker | plain] Region whose SNS endpoint sends the text messages (may differ from the others).
SNS_REGION=me-central-1
# [api worker | plain] Sender ID shown on the phone, where the destination country allows one. Blank = none.
SMS_SENDER_ID=LOONS
# [api worker | plain] Texts one phone number may receive per rolling hour (1 to 1000; blank = 20).
SMS_MAX_PER_RECIPIENT_PER_HOUR=20

# ── Microsoft Teams ──────────────────────────────────────────────────────────

# [api worker | plain] webhook in production (console is refused). The webhook URLs themselves are
# stored per team in the database (Admin -> Teams), not here.
TEAMS_PROVIDER=webhook
# [api worker | plain] Hosts a webhook URL may point at (host or *.domain). Blank = the Microsoft defaults.
TEAMS_WEBHOOK_HOSTS=
# [api worker | plain] Webhook request timeout in ms (1000 to 60000).
TEAMS_TIMEOUT_MS=10000

# ── Worker ───────────────────────────────────────────────────────────────────

# [worker | plain] true on the always-on worker service (1 or 2 tasks): every task with true
# upserts the same five schedulers (SLA scan, auto-close, digest, sweep, retention), never duplicates
# them. false on additional scale-out worker tasks. Blank = true.
WORKER_SCHEDULERS=true
# [worker | plain] File the worker refreshes while healthy; the container health check reads it.
# The worker image sets /tmp/loons-worker-heartbeat.
WORKER_HEARTBEAT_FILE=/tmp/loons-worker-heartbeat

# ── Production seed (one-off task of the migrate image) ──────────────────────

# [migrate | plain] Configuration only in production: teams, categories, SLA policies, templates.
# Demo data is never created in production, whatever this says.
SEED_DEMO_DATA=false
# [migrate | secret] Password of seeded demo users; unused in production (no demo users).
SEED_DEMO_PASSWORD=
# [migrate | plain] Optional: creates the first SUPER_ADMIN (SSO only, no password). Must be an
# address on STAFF_EMAIL_DOMAIN; that person signs in with Microsoft Entra ID.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
